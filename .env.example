# Copie este arquivo para ".env" e preencha os valores. O ".env" nunca vai para o Git.

# Endereço do projeto no Supabase (Project Settings > API > Project URL).
SUPABASE_URL=

# Chave service_role (Project Settings > API). É secreta: dá acesso total ao banco.
# Use só no seu computador, para importar conteúdo. Nunca coloque no app nem no Git.
SUPABASE_SERVICE_ROLE_KEY=

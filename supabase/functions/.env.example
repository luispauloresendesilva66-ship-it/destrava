# Segredos da Edge Function video-url. NUNCA commite o arquivo .env real.
# Em produção use: npx supabase secrets set B2_KEY_ID=... (o controller faz isso).
# Se TODAS as variáveis B2_* abaixo (exceto B2_REGION) estiverem preenchidas, os vídeos vêm do
# Backblaze B2; caso contrário, do Supabase Storage (bucket lesson-videos).

# ID da chave de aplicação do Backblaze B2 (keyID)
B2_KEY_ID=
# Chave de aplicação (applicationKey), SECRETA
B2_APPLICATION_KEY=
# Nome do bucket privado (atenção: o nome real termina com hífen)
B2_BUCKET=
# Endpoint S3 do bucket, sem https://, ex.: s3.us-east-005.backblazeb2.com
B2_ENDPOINT=
# Região do endpoint (opcional; padrão us-east-005)
B2_REGION=

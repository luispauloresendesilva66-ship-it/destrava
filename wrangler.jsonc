// Cloudflare Workers (static assets): serve the built PWA from web/dist.
// Build first with `npm --prefix web run build`; SPA routes fall back to index.html.
{
  "name": "destrava",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application"
  }
}
